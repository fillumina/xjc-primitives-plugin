<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="primitives" type="Primitives"/>

  <xs:complexType name="Primitives">
    <xs:sequence>
      <xs:element name="count" type="xs:int"/>
      <xs:element name="amount" type="xs:long"/>
      <xs:element name="active" type="xs:boolean"/>
      <xs:element name="ratio" type="xs:double"/>
      <xs:element name="tiny" type="xs:byte"/>
      <xs:element name="small" type="xs:short"/>
      <xs:element name="fraction" type="xs:float"/>
    </xs:sequence>
    <xs:attribute name="flag" type="xs:boolean"/>
  </xs:complexType>

</xs:schema>
